#!/bin/bash

[[ "${BASH_SOURCE[0]}" == "${0}" ]] && err "usage: source $user_path/init"

set -o allexport

alias md="mkdir --parents"
alias skip=":"

MSYS=winsymlinks:nativestrict

PWD=$( cygpath --unix $( pwd ) )
PWD=${PWD/#$HOME/\~}

function var {
	[[ -v $1 ]] || declare $1=$2
}

function let {
	declare $1=$2
}

var user_name $( whoami )
var user_user $( whoami )
var user_path ~/desktop
var user_bell none

bind "set bell-style $user_bell"

function path {
	[[ -z $1 ]] && { echo $PATH | tr : "\n"; return; }
	export PATH=$1:$PATH
}

path $user_path/user
path $user_path/user/profile/$user_name

function err {
	echo error: $@
	return 1
}

function has {
	command -v $1 &> /dev/null || err
}

function use {
	[[ -z $1 ]] && return

	local -; set -o allexport

	[[ $( type -t use_$1 ) == function ]] && eval "use_$1"
	[[ -d ~/desktop/user/package/$1 ]] && path ~/desktop/user/package/$1
	[[ -f ~/desktop/user/module/$1 ]] && source ~/desktop/user/module/$1
}

function md {
	mkdir --parents "$@"
}
